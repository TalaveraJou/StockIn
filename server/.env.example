# Copia este archivo como .env y rellena los valores reales
# NUNCA subas .env al repositorio

# Secreto para firmar los JWT — cambia esto por una cadena larga y aleatoria en producción
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio

# Credenciales del superadmin (opcionales; si no se definen se usan los valores de demo)
SUPERADMIN_EMAIL=tu@email.es
SUPERADMIN_PASSWORD=contraseña-segura

# Orígenes permitidos para CORS — separados por coma, sin espacios
# Ejemplo: https://tu-app.vercel.app,https://otro-dominio.com
ALLOWED_ORIGINS=http://localhost:5173

# Puerto (Railway lo asigna automáticamente; en local usa 3001)
PORT=3001
